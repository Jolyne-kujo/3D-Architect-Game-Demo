  m_Script: {fileID: 11500000, guid: fc0861c6100e4ff58f93cff2c67f8f9b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CoastalTemple.Tutorial.TutorialJourney
  interactor: {fileID: 761032074}
  playerLantern: {fileID: 761032072}
  hud: {fileID: 1844292455}
  lessons:
  - name: 01_BorrowedBridge
    title: "\u501F\u5149\u65AD\u5ECA"
    safetyNote: "\u5931\u8DB3\u8FD4\u56DE\u672C\u6BB5\u5165\u53E3 \xB7 \u673A\u5173\u4FDD\u7559\u5F53\u524D\u72B6\u6001"
    marker: {fileID: 1710783964}
    radius: 22
    hints:
    - "\u770B\u4E00\u770B\uFF1A\u5149\u7167\u5230\u7EA2\u77F3\u677F\u4E0E\u91D1\u8272\u53D7\u5149\u5668\u65F6\uFF0C\u811A\u4E0B\u5404\u53D1\u751F\u4E86\u4EC0\u4E48\uFF1F"
    - "\u4E2D\u95F4\u7684\u5C0F\u5C9B\u4E0D\u4F1A\u968F\u5149\u53D8\u5316\u3002\u7AD9\u5728\u90A3\u91CC\uFF0C\u518D\u51B3\u5B9A\u4E0B\u4E00\u6BB5\u9700\u8981\u7559\u4E0B\u54EA\u4E00\u79CD\u8DEF\u3002"
    - "\u5148\u501F\u5149\u8D70\u5230\u4E2D\u5C9B\uFF1B\u6536\u5149\u540E\uFF0C\u8BA9\u7EA2\u8272\u627F\u91CD\u677F\u56DE\u6765\u3002"
    completionCondition: {fileID: 1710783962}
    completionMessage: "\u628A\u5149\u8FD8\u56DE\u53BB\uFF0C\u4E5F\u80FD\u9020\u51FA\u8DEF\u3002\n\u63D0\u706F\u53EF\u4EE5\u5E26\u8D70\uFF0CL
      \u5F00\u5173\u7167\u660E\u3002"
    onCompleted:
      m_PersistentCalls:
        m_Calls: []
  - name: 02_StoneWorkshop
    title: "\u65AD\u9636\u5DE5\u574A"
    safetyNote: "\u5931\u8DB3\u8FD4\u56DE\u672C\u6BB5\u5165\u53E3 \xB7 \u673A\u5173\u4FDD\u7559\u5F53\u524D\u72B6\u6001"
    marker: {fileID: 1435279884}
    radius: 22
    hints:
    - "\u5347\u5230\u6700\u9AD8\u5904\u4E4B\u524D\uFF0C\u4E2D\u5C42\u6709\u4E00\u53F0\u5377\u626C\u3002\u77F3\u5899\u4E5F\u53EF\u4EE5\u5F53\u4F5C\u811A\u4E0B\u7684\u5DE5\u4F5C\u53F0\u3002"
    - "\u5149\u79FB\u5F00\u540E\uFF0C\u5347\u964D\u5899\u4F1A\u505C\u5728\u539F\u5904\u3002\u628A\u5B83\u505C\u5230\u4FA7\u5ECA\u9AD8\u5EA6\uFF0C\u53BB\u8BD5\u8BD5\u6A2A\u5411\u5377\u626C\u3002"
    - "\u6A2A\u6865\u4E2D\u7EBF\u5BF9\u9F50\u91D1\u8272\u523B\u7EBF\u540E\u505C\u8F66\uFF0C\u518D\u4E58\u77F3\u5899\u4E0A\u53BB\u3002"
    completionCondition: {fileID: 1435279882}
    completionMessage: "\u65AD\u5F00\u7684\u9AD8\u5ECA\u88AB\u4F60\u63A5\u8D77\u6765\u4E86\u3002\n\u56DE\u671B\u6D77\u5CB8\uFF1A\u4E00\u8DEF\u8D70\u8FC7\u7684\u673A\u5173\u4ECD\u7559\u5728\u539F\u5904\u3002"
    onCompleted:
      m_PersistentCalls:
        m_Calls: []
  - name: 03_FoldedBridge
    title: "\u6298\u5149\u4FEE\u6865"
    safetyNote: "\u5931\u8DB3\u8FD4\u56DE\u672C\u6BB5\u5165\u53E3 \xB7 \u673A\u5173\u4FDD\u7559\u5F53\u524D\u72B6\u6001"
    marker: {fileID: 259679403}
